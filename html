function getScaleFactor() { return 1 + (game.level - 1) * 0.18; }

function startWave(idx) {
    const wave = WAVES[idx];
    game.wave = idx; game.biome = wave.biome;
    game.waveActive = true; game.waveDefeated = 0; game.boss = null; game.enemies = [];
    let count = 0;
    for (const typeKey of wave.enemies) { spawnEnemy(typeKey); count++; }
    game.waveTotal = count;
    addMessage((wave.boss ? '👑 CHEFE: ' : '⚔️ ONDA ' + (idx+1) + ': ') + wave.name, wave.boss ? '#ff6666' : '#ffee44', 3);
    if (wave.boss) audio.bossAlert();
    if (wave.boss && game.player.char.reactions) characterReaction(game.player.char.reactions.boss);
    if (idx === 2 && !game.storyTriggers.has('spirit')) { game.storyTriggers.add('spirit'); setTimeout(() => { if (state === 'playing') showStoryChoice('spirit'); }, 100); }
    if (idx === 4 && !game.storyTriggers.has('river')) { game.storyTriggers.add('river'); setTimeout(() => { if (state === 'playing') showStoryChoice('river'); }, 100); }
    if (idx === 6 && !game.storyTriggers.has('ally')) { game.storyTriggers.add('ally'); setTimeout(() => { if (state === 'playing') showStoryChoice('ally'); }, 100); }
}

function characterReaction(text) { if (!game.player.char.reactions) return; game.player.reactionText = text; game.player.reactionTimer = 180; }

function spawnEnemy(typeKey) {
    const type = ENEMY_TYPES[typeKey];
    const cfg = DIFFICULTIES[difficulty];
    const hp = Math.round(type.hp * (1 + game.wave * 0.12) * cfg.hpMult * getScaleFactor());
    let ex, ey, tries = 0;
