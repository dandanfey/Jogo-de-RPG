const introContent = document.getElementById('introContent');
const introProgress = document.getElementById('introProgress');
const introSkip = document.getElementById('introSkip');
const introCanvas = document.getElementById('introCanvas');
const introCtx = introCanvas.getContext('2d');
let introActive = true, introScene = 0, introTime = 0;
function resizeIntro() { introCanvas.width = window.innerWidth; introCanvas.height = window.innerHeight; }
window.addEventListener('resize', resizeIntro); resizeIntro();

const introScenes = [
    { lines: [{ text: 'Há 3 meses...', cls: 'whisper', delay: 0 }, { text: 'um grupo de aventureiros', delay: 700 }, { text: 'planejava a expedição de suas vidas.', delay: 1400 }], duration: 3200 },
    { lines: [{ text: 'A floresta os observa.', cls: 'whisper', delay: 0 }, { text: 'Seres antigos habitam as sombras...', delay: 700 }, { text: 'Alguns ajudarão. Outros... não.', delay: 1400, cls: 'epic' }], duration: 3200 },
    { title: 'A JORNADA SOMBRIA', subtitle: 'PERSONAGENS VIVOS', duration: 3200 }
];

function startIntro() { introActive = true; introOverlay.classList.add('active'); introScene = 0; showScene(0); }
function showScene(idx) {
    if (idx >= introScenes.length) { endIntro(); return; }
    const scene = introScenes[idx]; introContent.innerHTML = '';
    if (scene.title) {
        const t = document.createElement('div'); t.className = 'intro-title'; t.textContent = scene.title; introContent.appendChild(t);
        const s = document.createElement('div'); s.className = 'intro-sub'; s.textContent = scene.subtitle; introContent.appendChild(s);
        setTimeout(() => t.classList.add('show'), 100);
        setTimeout(() => s.classList.add('show'), 700);
    } else {
        scene.lines.forEach(line => {
            const le = document.createElement('div'); le.className = 'intro-line ' + (line.cls || ''); le.textContent = line.text; introContent.appendChild(le);
            setTimeout(() => le.classList.add('show'), line.delay + 100);
        });
    }
    introProgress.style.width = ((idx + 1) / introScenes.length * 100) + '%';
    setTimeout(() => { if (!introActive) return; introScene++; showScene(introScene); }, scene.duration);
}
function endIntro() { introActive = false; introOverlay.classList.remove('active'); document.getElementById('menuOverlay').classList.add('active'); state = 'menu'; }
introSkip.addEventListener('click', endIntro);

function drawIntro() {
    if (!introActive) return;
    introTime += 0.016;
    const iw = introCanvas.width, ih = introCanvas.height;
    const skyGrad = introCtx.createLinearGradient(0, 0, 0, ih);
    skyGrad.addColorStop(0, '#3a5a7a'); skyGrad.addColorStop(0.5, '#5a3a6a'); skyGrad.addColorStop(1, '#2a4a2a');
    introCtx.fillStyle = skyGrad; introCtx.fillRect(0, 0, iw, ih);
    for (let i = 0; i < 100; i++) {
        const sx = (i*137)%iw, sy = (i*89)%(ih*0.6);
        const tw = 0.5 + Math.sin(introTime*2 + i)*0.5;
        introCtx.fillStyle = `rgba(240,250,255,${tw})`;
        introCtx.beginPath(); introCtx.arc(sx, sy, 1.5 + (i%3)*0.5, 0, Math.PI*2); introCtx.fill();
    }
    introCtx.fillStyle = '#2a4a2a';
    for (let i = 0; i < 20; i++) {
        const tx = ((i*90 + introTime*15) % (iw+200)) - 100;
        const th = 100 + (i%5)*40;
        introCtx.beginPath(); introCtx.moveTo(tx, ih-th); introCtx.lineTo(tx-40, ih); introCtx.lineTo(tx+40, ih); introCtx.closePath(); introCtx.fill();
    }
    requestAnimationFrame(drawIntro);
}
requestAnimationFrame(drawIntro); startIntro();

// ==================== CONFIG ====================
const DIFFICULTIES = {
