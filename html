    } while ((ex < 80 || ex > W-80 || ey < 80 || ey > H-80) && tries < 40);
    ex = Math.max(80, Math.min(W-80, ex));
    ey = Math.max(80, Math.min(H-80, ey));
    const e = {
        typeKey, type, x: ex, y: ey, size: type.size, hp, maxHp: hp,
        speed: type.speed * (1 + game.wave * 0.03) * (1 + (game.level-1) * 0.04),
        dmg: Math.round(type.dmg * cfg.dmgMult * (1 + (game.level-1) * 0.06)),
        xp: Math.round(type.xp * cfg.xpMult),
        attackCd: 0, hitFlash: 0, stunned: 0, spawnTime: 30,
        animOffset: Math.random() * Math.PI * 2,
        isBoss: type.type === 'boss',
        bossPhase: 1, bossCd: type.type === 'boss' ? 240 : 0,
        isRanged: type.type === 'ranged' || type.ranged, projCd: 0,
        retreating: false, dialogue: '', dialogueTimer: 0
    };
    if (e.isBoss) {
        e.dialogue = ['Seus tolos!', 'A floresta é minha!', 'Vocês vão morrer!', 'Sinta meu poder!'][Math.floor(Math.random()*4)];
        e.dialogueTimer = 180;
    }
    game.enemies.push(e);
    if (e.isBoss) { game.boss = e; addMessage('💀 ' + type.name + ' apareceu!', '#ff6666', 3); triggerShake(20); }
}

function spawnEnemyAt(typeKey, x, y) {
    const type = ENEMY_TYPES[typeKey];
    const cfg = DIFFICULTIES[difficulty];
    const hp = Math.round(type.hp * (1 + game.wave * 0.12) * cfg.hpMult * getScaleFactor());
    game.enemies.push({
        typeKey, type, x: Math.max(60, Math.min(W-60, x)), y: Math.max(60, Math.min(H-60, y)),
