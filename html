let luChoices = [], luSelected = null;

function checkLevelUp() {
    if (game.xp >= game.xpToNext) {
        game.xp -= game.xpToNext;
        game.level++;
        game.xpToNext = Math.floor(game.xpToNext * 1.35);
        audio.levelUp();
        const evo = game.player.char.evolutions[game.player.evoLevel];
        if (evo && game.level >= evo.level) { showEvolution(evo); return; }
        showLevelUp();
    }
}

function showEvolution(evo) {
    state = 'levelup'; game.paused = true;
    const p = game.player;
    p.maxHp += evo.hpBonus; p.hp = p.maxHp;
    p.dmgMult += evo.dmgBonus; p.evoLevel++;
    p.char.color = evo.color;
    if (evo.shieldBonus) { p.maxShield += evo.shieldBonus; p.shield = p.maxShield; }
    document.getElementById('evoName').textContent = evo.name;
    document.getElementById('evoDesc').innerHTML = evo.desc + (evo.shieldBonus ? '<br><b style="color:#88ddff">+' + evo.shieldBonus + ' Escudo</b>' : '') + '<br><br><b style="color:#ffdd44;">Evolução: ' + p.evoLevel + '/3</b>';
    document.getElementById('evoIcon').textContent = p.char.icon;
    document.getElementById('evoOverlay').classList.add('active');
    document.getElementById('evoConfirm').onclick = () => {
        document.getElementById('evoOverlay').classList.remove('active');
        game.paused = false; state = 'playing';
        addMessage('✨ EVOLUÇÃO: ' + evo.name + '!', '#ffcc22', 3);
    };
}

function showLevelUp() {
    state = 'levelup'; game.paused = true;
    document.getElementById('luLevel').textContent = game.level;
    const pool = [...UPGRADE_POOL];
    luChoices = [];
    for (let i = 0; i < 3; i++) { const idx = Math.floor(Math.random() * pool.length); luChoices.push(pool.splice(idx, 1)[0]); }
    luSelected = null;
    const grid = document.getElementById('upgradeGrid');
    grid.innerHTML = '';
    luChoices.forEach(c => {
        const card = document.createElement('div');
        card.className = 'upgrade-card';
        card.innerHTML = `<div class="up-icon">${c.icon}</div><div class="up-name">${c.name}</div><div class="up-desc">${c.desc}</div>`;
        card.addEventListener('click', () => { grid.querySelectorAll('.upgrade-card').forEach(el => el.classList.remove('selected')); card.classList.add('selected'); luSelected = c; document.getElementById('upgradeConfirm').style.display = 'block'; });
        grid.appendChild(card);
    });
    document.getElementById('upgradeConfirm').style.display = 'none';
    document.getElementById('upgradeConfirm').onclick = () => {
        if (!luSelected) return;
        luSelected.apply();
        document.getElementById('levelUpOverlay').classList.remove('active');
        game.paused = false; state = 'playing';
        addMessage('✅ ' + luSelected.name, '#ffee44', 1.5);
        if (game.xp >= game.xpToNext) setTimeout(checkLevelUp, 200);
    };
    document.getElementById('levelUpOverlay').classList.add('active');
}

