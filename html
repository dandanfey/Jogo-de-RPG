        this.icon = type === 'hunter' ? '🏹' : (type === 'soldier' ? '🎖️' : '🌿');
        this.color = type === 'hunter' ? '#bbffbb' : (type === 'soldier' ? '#bbddff' : '#bbffbb');
        this.phase = Math.random() * Math.PI * 2;
        this.offsetX = 0; this.offsetY = 0;
        this.name = name || 'Aliado';
        this.barkTimer = 0;
        this.barks = ['Estou com você!', 'Cuidado!', 'Deixa comigo!', 'Mais um!'];
    }
    update(dt, player, enemies) {
        if (this.attackCd > 0) this.attackCd -= dt * 60;
        if (this.barkTimer > 0) this.barkTimer -= dt * 60;
        this.phase += dt * 3;
        const targetX = player.x + this.offsetX;
        const targetY = player.y + this.offsetY;
        const dist = Math.hypot(targetX - this.x, targetY - this.y);
        if (dist > 10) {
            this.x += ((targetX - this.x) / dist) * this.speed * dt;
            this.y += ((targetY - this.y) / dist) * this.speed * dt;
        }
        if (this.attackCd <= 0) {
            let nearest = null, nd = 250;
            for (const e of enemies) {
                if (e.hp <= 0) continue;
                const d = Math.hypot(e.x - this.x, e.y - this.y);
                if (d < nd) { nd = d; nearest = e; }
            }
            if (nearest) {
                this.attackCd = 35;
                damageEnemy(nearest, this.dmg, this.color);
                if (Math.random() < 0.15 && this.barkTimer <= 0) {
                    this.barkTimer = 200;
                    showFloatingText(this.x, this.y - 30, this.barks[Math.floor(Math.random()*this.barks.length)], this.color);
                }
            }
        }
    }
    draw(ctx) {
        const bob = Math.sin(this.phase) * 2;
        ctx.save();
        ctx.shadowColor = this.color; ctx.shadowBlur = 18;
        ctx.fillStyle = this.color;
        ctx.beginPath(); ctx.arc(this.x, this.y + bob, 12, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
        ctx.font = '16px "Courier New"'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(this.icon, this.x, this.y + bob);
        ctx.strokeStyle = '#000'; ctx.lineWidth = 3;
        ctx.font = 'bold 9px "Courier New"';
        ctx.strokeText(this.name, this.x, this.y - 22 + bob);
        ctx.fillStyle = this.color;
        ctx.fillText(this.name, this.x, this.y - 22 + bob);
    }
}

// ==================== AMBIENTE (CORRIGIDO) ====================
class Environment {
    constructor() {
        this.timeOfDay = 0.5; // 0 = midnight, 0.5 = noon, 1 = midnight
        this.daySpeed = 0.00008;
        this.weather = 'clear'; this.weatherTimer = 800; this.weatherIntensity = 0;
        this.rainDrops = []; this.fireflies = []; this.leaves = []; this.clouds = [];
        this.lightningTimer = 0; this.lightningFlash = 0;
        this.windStrength = 0; this.windDirection = 1;
        this.initAmbient();
    }
    initAmbient() {
        for (let i = 0; i < 20; i++) this.fireflies.push({ x: Math.random()*W, y: Math.random()*H, vx:(Math.random()-0.5)*20, vy:(Math.random()-0.5)*20, phase: Math.random()*Math.PI*2, size: 3+Math.random()*2 });
        for (let i = 0; i < 15; i++) this.leaves.push({ x: Math.random()*W, y: Math.random()*H, vx: 20+Math.random()*30, vy: 10+Math.random()*20, rot: Math.random()*Math.PI*2, rotSpeed: (Math.random()-0.5)*4, size: 5+Math.random()*4, color: ['#bbdd77','#99bb55','#ddbb77','#eebb88'][Math.floor(Math.random()*4)] });
        for (let i = 0; i < 8; i++) this.clouds.push({ x: Math.random()*W, y: 30+Math.random()*200, scale: 0.7+Math.random()*0.8, speed: 8+Math.random()*15 });
    }
    // Fórmula correta: 0 ao meio-dia, 1 à meia-noite
    getNightFactor() {
        const dist = Math.abs(this.timeOfDay - 0.5); // 0 at noon, 0.5 at midnight
        return Math.min(1, dist * 2);
    }
    getDayFactor() {
        return Math.max(0, 1 - Math.abs(this.timeOfDay - 0.5) * 2);
    }
    update(dt) {
        this.timeOfDay += this.daySpeed * dt * 60;
        if (this.timeOfDay > 1) this.timeOfDay -= 1;
        this.windStrength = 0.5 + Math.sin(performance.now() * 0.0003) * 0.5;
        this.windDirection = Math.sin(performance.now() * 0.0002) > 0 ? 1 : -1;
        this.weatherTimer -= dt * 60;
        if (this.weatherTimer <= 0) {
            this.weatherTimer = 800 + Math.random() * 800;
            this.weather = ['clear','clear','clear','rain','fog'][Math.floor(Math.random()*5)];
        }
        const targetIntensity = (this.weather==='clear')?0:(this.weather==='rain')?0.8:(this.weather==='fog')?0.6:0;
        this.weatherIntensity += (targetIntensity - this.weatherIntensity) * dt * 2;
        if (this.weather === 'rain' || this.weather === 'storm') {
            const dropCount = Math.floor(this.weatherIntensity * 3);
            for (let i = 0; i < dropCount; i++) this.rainDrops.push({ x: Math.random()*W, y: -10, vx: this.windDirection*100, vy: 800, life: 60 });
        }
        for (let i = this.rainDrops.length-1; i >= 0; i--) { const d = this.rainDrops[i]; d.x += d.vx*dt; d.y += d.vy*dt; d.life--; if (d.life <= 0 || d.y > H) this.rainDrops.splice(i,1); }
        for (const f of this.fireflies) { f.vx += (Math.random()-0.5)*10; f.vy += (Math.random()-0.5)*10; f.vx *= 0.95; f.vy *= 0.95; f.x += f.vx*dt; f.y += f.vy*dt; f.phase += dt*3; if (f.x < 0) f.x = W; if (f.x > W) f.x = 0; if (f.y < 0) f.y = H; if (f.y > H) f.y = 0; }
        for (const l of this.leaves) { l.x += (l.vx + this.windStrength*this.windDirection*40)*dt; l.y += (l.vy + Math.sin(performance.now()*0.001 + l.rot)*20)*dt; l.rot += l.rotSpeed*dt; if (l.x > W+10) l.x = -10; if (l.y > H+10) l.y = -10; }
        for (const c of this.clouds) { c.x += c.speed*dt; if (c.x > W+100) c.x = -100; }
    }
    getSkyInfo() {
        const t = this.timeOfDay;
        let skyColor1, skyColor2;
        if (t < 0.2) { skyColor1='#4a5a7a'; skyColor2='#3a4a6a'; } // meia-noite (menos escuro)
        else if (t < 0.35) { const f=(t-0.2)/0.15; skyColor1=this.lerpColor('#4a5a7a','#ffcc88',f); skyColor2=this.lerpColor('#3a4a6a','#ffdd99',f); } // amanhecer
        else if (t < 0.65) { skyColor1='#aaddff'; skyColor2='#ddeeff'; } // dia (bem claro)
        else if (t < 0.8) { const f=(t-0.65)/0.15; skyColor1=this.lerpColor('#aaddff','#ff9955',f); skyColor2=this.lerpColor('#ddeeff','#ffcc88',f); } // entardecer
        else { const f=(t-0.8)/0.2; skyColor1=this.lerpColor('#ff9955','#4a5a7a',f); skyColor2=this.lerpColor('#ffcc88','#3a4a6a',f); } // noite
        return { skyColor1, skyColor2 };
    }
    lerpColor(a, b, t) {
        const ah = parseInt(a.slice(1),16), bh = parseInt(b.slice(1),16);
        const ar = (ah>>16)&0xff, ag = (ah>>8)&0xff, ab = ah&0xff;
        const br = (bh>>16)&0xff, bg = (bh>>8)&0xff, bb = bh&0xff;
        const rr = Math.round(ar+(br-ar)*t), rg = Math.round(ag+(bg-ag)*t), rb = Math.round(ab+(bb-ab)*t);
        return '#' + ((rr<<16)|(rg<<8)|rb).toString(16).padStart(6,'0');
    }
    drawParticles(ctx) {
        // Vaga-lumes SÓ À NOITE (corrigido)
        const nightF = this.getNightFactor();
        if (nightF > 0.4) {
            for (const f of this.fireflies) {
                const alpha = (Math.sin(f.phase) * 0.5 + 0.5) * (nightF - 0.4) / 0.6;
                ctx.fillStyle = `rgba(240,255,150,${alpha})`;
                ctx.shadowColor = '#eeff99'; ctx.shadowBlur = 12;
                ctx.beginPath(); ctx.arc(f.x, f.y, f.size, 0, Math.PI * 2); ctx.fill();
            }
            ctx.shadowBlur = 0;
        }
        for (const l of this.leaves) {
            ctx.save(); ctx.translate(l.x, l.y); ctx.rotate(l.rot);
            ctx.fillStyle = l.color; ctx.globalAlpha = 0.85;
            ctx.beginPath(); ctx.ellipse(0, 0, l.size, l.size * 0.5, 0, 0, Math.PI * 2); ctx.fill();
            ctx.restore();
        }
        ctx.globalAlpha = 1;
        for (const d of this.rainDrops) {
            ctx.strokeStyle = `rgba(180,210,240,${d.life/60*0.8})`;
            ctx.lineWidth = 2;
            ctx.beginPath(); ctx.moveTo(d.x, d.y); ctx.lineTo(d.x - d.vx*0.02, d.y - d.vy*0.02); ctx.stroke();
        }
    }
    drawWeatherOverlay(ctx) {
        // Névoa
        if (this.weather === 'fog') {
            const alpha = this.weatherIntensity * 0.2;
            const grad = ctx.createRadialGradient(W/2, H/2, 100, W/2, H/2, W*0.7);
            grad.addColorStop(0, `rgba(220,240,240,0)`);
            grad.addColorStop(1, `rgba(220,240,240,${alpha})`);
            ctx.fillStyle = grad; ctx.fillRect(0, 0, W, H);
        }
        // Relâmpago
        if (this.lightningFlash > 0) {
            ctx.fillStyle = `rgba(240,245,255,${this.lightningFlash * 0.5})`;
            ctx.fillRect(0, 0, W, H);
        }
        // Noite CORRIGIDA: só escurece à noite
        const nightF = this.getNightFactor();
        if (nightF > 0.05) {
            ctx.fillStyle = `rgba(30,40,70,${nightF * 0.35})`;
            ctx.fillRect(0, 0, W, H);
        }
        // DIA: adiciona brilho suave
        const dayF = this.getDayFactor();
        if (dayF > 0.2) {
            ctx.fillStyle = `rgba(255,255,220,${dayF * 0.06})`;
            ctx.fillRect(0, 0, W, H);
        }
    }
}

