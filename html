// ==================== AUDIO ====================
class AudioEngine {
    constructor() { this.ctx = null; this.muted = false; this.masterGain = null; this.init(); }
    init() { try { this.ctx = new (window.AudioContext || window.webkitAudioContext)(); this.masterGain = this.ctx.createGain(); this.masterGain.gain.value = 0.15; this.masterGain.connect(this.ctx.destination); } catch(e) { this.ctx = null; } }
    resume() { if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume(); }
    play(freq, duration, type, volume, slide) {
        if (!this.ctx || this.muted) return;
        try {
            const osc = this.ctx.createOscillator(); const gain = this.ctx.createGain();
            osc.type = type || 'sine'; osc.frequency.value = freq;
            if (slide) osc.frequency.exponentialRampToValueAtTime(slide, this.ctx.currentTime + duration);
            gain.gain.setValueAtTime(volume || 0.3, this.ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
            osc.connect(gain); gain.connect(this.masterGain); osc.start(); osc.stop(this.ctx.currentTime + duration);
        } catch(e) {}
    }
    noise(duration, volume) {
        if (!this.ctx || this.muted) return;
        try {
            const bufferSize = this.ctx.sampleRate * duration;
            const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
            const source = this.ctx.createBufferSource(); source.buffer = buffer;
            const gain = this.ctx.createGain();
            gain.gain.setValueAtTime(volume || 0.2, this.ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);
            const filter = this.ctx.createBiquadFilter(); filter.type = 'lowpass'; filter.frequency.value = 2000;
            source.connect(filter); filter.connect(gain); gain.connect(this.masterGain); source.start();
        } catch(e) {}
    }
    shoot(w) { const c = w.cat; if (c==='RIFLE'||c==='SMG'){this.play(180,0.08,'square',0.25,80);this.noise(0.06,0.15);}else if(c==='SHOTGUN'){this.play(90,0.15,'sawtooth',0.35,40);this.noise(0.12,0.3);}else if(c==='SNIPER'){this.play(220,0.25,'sawtooth',0.4,60);this.noise(0.2,0.3);}else if(c==='PISTOL'){this.play(320,0.06,'square',0.2,150);}else if(c==='HEAVY'){this.play(110,0.12,'sawtooth',0.3,60);this.noise(0.1,0.25);}else if(c==='ENERGY'){this.play(880,0.1,'sine',0.2,440);}else if(c==='MELEE'){this.noise(0.05,0.15);} }
    hit() { this.play(200, 0.05, 'square', 0.15, 100); }
    kill() { this.play(300, 0.15, 'sine', 0.25, 100); this.noise(0.15, 0.15); }
    levelUp() { this.play(523,0.15,'sine',0.3); setTimeout(()=>this.play(659,0.15,'sine',0.3),100); setTimeout(()=>this.play(784,0.3,'sine',0.35),200); }
