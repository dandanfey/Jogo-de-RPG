const storyOverlay = document.getElementById('storyOverlay');
const storyChoicesEl = document.getElementById('storyChoices');
const buffsPanel = document.getElementById('buffsPanel');
let currentStoryCallback = null;

function getKarmaLabel(karma) {
    if (karma >= 8) return { label:'SANTO', color:'#ffee44', icon:'😇' };
    if (karma >= 4) return { label:'BOM', color:'#88ff88', icon:'😊' };
    if (karma >= -3) return { label:'NEUTRO', color:'#dddddd', icon:'😐' };
    if (karma >= -7) return { label:'MAU', color:'#ffaa66', icon:'😈' };
    return { label:'DEMÔNIO', color:'#ff4444', icon:'👹' };
}

function updateKarmaDisplay() {
    if (!game || !game.player) return;
    const karma = game.player.karma || 0;
    const info = getKarmaLabel(karma);
    const indicator = document.getElementById('karmaIndicator');
    const label = document.getElementById('karmaLabel');
    const pct = Math.max(5, Math.min(95, ((karma + 15) / 30) * 100));
    indicator.style.left = pct + '%';
    indicator.style.background = info.color;
    indicator.style.boxShadow = '0 0 12px ' + info.color;
    label.textContent = info.label;
    label.style.color = info.color;
}

function showStoryChoice(choiceId, callback) {
    const choice = STORY_CHOICES[choiceId];
    if (!choice) { if (callback) callback(); return; }
    state = 'story';
    if (game) game.paused = true;
    currentStoryCallback = callback;
    document.getElementById('storyChapter').textContent = choice.chapter;
    document.getElementById('storyTitle').textContent = choice.title;
    document.getElementById('storySubtitle').textContent = choice.subtitle;
    document.getElementById('storyImage').textContent = choice.image;
    document.getElementById('storyText').innerHTML = choice.text;
    const karmaInfo = getKarmaLabel(game ? (game.player.karma || 0) : 0);
    document.getElementById('storyKarma').innerHTML = `<span>${karmaInfo.icon}</span><span style="color:${karmaInfo.color}">${karmaInfo.label}</span>`;
    storyChoicesEl.innerHTML = '';
    choice.choices.forEach(c => {
        const el = document.createElement('div');
        el.className = 'story-choice';
        el.innerHTML = `<div class="choice-icon">${c.icon}</div><div class="choice-content"><div class="choice-label">${c.label}</div><div class="choice-desc">${c.desc}</div><div class="choice-consequence">${c.consequence}</div></div>`;
        el.addEventListener('click', () => {
            audio.pickup();
            if (game && c.karma) {
                game.player.karma += c.karma;
                if (c.karma > 0) showEffectPopup('😊', '+' + c.karma + ' KARMA', '#88ff88');
                else if (c.karma < 0) showEffectPopup('😈', c.karma + ' KARMA', '#ff4444');
                updateKarmaDisplay();
            }
            applyStoryEffect(c.effect);
            storyOverlay.classList.remove('active');
            if (game) game.paused = false;
            state = 'playing';
            if (currentStoryCallback) currentStoryCallback();
        });
        storyChoicesEl.appendChild(el);
    });
    storyOverlay.classList.add('active');
}

function showEffectPopup(icon, text, color) {
    // Previne spam: mínimo 800ms entre popups
    const now = performance.now();
    if (now - lastPopupTime < 800) return;
    lastPopupTime = now;
    const popup = document.createElement('div');
    popup.className = 'effect-popup';
    popup.style.borderColor = color || '#ffee44';
    popup.style.color = color || '#ffee44';
    popup.innerHTML = `<div class="effect-icon">${icon}</div><div class="effect-text">${text}</div>`;
    document.body.appendChild(popup);
    setTimeout(() => popup.remove(), 3500);
}

function applyStoryEffect(effectId) {
    if (!game) return;
    const p = game.player;
    switch (effectId) {
        case 'determination': p.maxShield += 20; p.shield = p.maxShield; addBuff('🛡️ Determinação','+20 Escudo'); break;
        case 'camp':
            if (Math.random() < 0.5) { if (!p.weapons.includes('railgun')) p.weapons.push('railgun'); addBuff('⚔️ Arma Lendária','Railgun'); showEffectPopup('⚔️','ARMA LENDÁRIA!','#ff6666'); }
            else { for (let i=0;i<3;i++){const a=Math.random()*Math.PI*2; spawnEnemyAt('sombria', p.x+Math.cos(a)*300, p.y+Math.sin(a)*300);} addBuff('💀 Emboscada','Inimigos'); showEffectPopup('💀','EMBOSCADA!','#ff4444'); }
            break;
        case 'rest': p.hp = p.maxHp; p.shield = p.maxShield; addBuff('😴 Descanso','Cheio'); break;
        case 'blessing': p.maxHp += 40; p.hp = p.maxHp; p.dmgMult += 0.25; addBuff('🌟 Bênção','HP+Dano'); break;
        case 'challenge': spawnEnemyAt('xamaSombrio', p.x+400, p.y+300); spawnEnemyAt('loboAlpha', p.x, p.y+400); break;
        case 'swim': p.speed *= 1.2; p.shield = Math.max(0, p.shield-30); addBuff('🏊 Nado','+Vel'); break;
        case 'raft': for (let i=0;i<2;i++){const a=Math.random()*Math.PI*2; spawnEnemyAt('guardiao', p.x+Math.cos(a)*350, p.y+Math.sin(a)*350);} break;
        case 'detour': for (let i=0;i<2;i++){const a=Math.random()*Math.PI*2; spawnEnemyAt('lobisomem', p.x+Math.cos(a)*300, p.y+Math.sin(a)*300);} break;
        case 'open_chest': if (Math.random()<0.5) { if (!p.weapons.includes('minigun')) p.weapons.push('minigun'); p.dmgMult += 0.3; showEffectPopup('💎','TESOURO!','#ffd700'); } else { for (let i=0;i<3;i++){const a=Math.random()*Math.PI*2; spawnEnemyAt('loboAlpha', p.x+Math.cos(a)*350, p.y+Math.sin(a)*350);} p.hp = Math.round(p.hp*0.7); } break;
        case 'examine': game.xp += game.xpToNext * 0.5; break;
        case 'leave_chest': game.xp += 50; break;
        case 'recruit': const comp = new Companion('hunter', p.x + 100, p.y, 'Caçador'); comp.offsetX = 100; comp.dmg = 20 + p.evoLevel * 8; game.companions.push(comp); p.xpMult *= 0.5; addBuff('🏹 Caçador','Aliado'); break;
        case 'rob': if (!p.weapons.includes('awm')) p.weapons.push('awm'); spawnEnemyAt('xamaSombrio', p.x+400, p.y); spawnEnemyAt('xamaSombrio', p.x-400, p.y); break;
        case 'honor': p.dmgMult += 1.0; addBuff('🔥 Honra','+100% Dano'); break;
        case 'vengeance': p.speed *= 1.6; p.atkSpeedMult *= 1.6; addBuff('⚡ Vingança','+Vel'); break;
        case 'balance': p.maxHp += 80; p.hp = p.maxHp; p.maxShield += 50; p.shield = p.maxShield; p.dmgMult += 0.3; break;
        case 'final_take': p.dmgMult += 1.5; break;
        case 'final_leave': p.maxShield += 100; p.shield = p.maxShield; p.dmgMult += 0.5; break;
        case 'final_destroy': for (const e of game.enemies) if (e.hp>0) damageEnemy(e, 500, '#ffee44', true); p.dmgMult += 1.0; break;
    }
}

function addBuff(name, desc) { game.buffs.push({ name, desc }); renderBuffs(); }
function renderBuffs() {
    if (!game || !game.buffs) { buffsPanel.innerHTML = ''; return; }
    buffsPanel.innerHTML = game.buffs.map(b => `<div class="buff-item">• ${b.name}</div>`).join('');
}

function addParticle(x, y, color, vx, vy, life, shape, size) {
    if (game.particles.length > 600) return;
    game.particles.push({ x, y, vx: vx||0, vy: vy||0, life: life||40, maxLife: life||40, color, size: size || (3+Math.random()*4), gravity: shape === 'ring' || shape === 'arc' ? 0 : 120, shape: shape || 'dot' });
}
function addDamageNumber(x, y, text, color, big) {
    game.damageNumbers.push({ x, y, text, color, vy: -80, life: big ? 75 : 60, maxLife: big ? 75 : 60, scale: big ? 1.5 : 1, big: big });
}
function addMessage(text, color, duration) { game.messages.push({ text, color, life: (duration||2)*60, maxLife: (duration||2)*60 }); }
function triggerShake(intensity) { game.shake = Math.max(game.shake, intensity); }

// ==================== UPDATE ====================
function update(dt) {
    if (state !== 'playing' || game.paused) return;
    if (hitStop > 0) { hitStop -= dt * 60; return; }
    game.time += dt;
    const p = game.player;
    environment.update(dt);
    updateShield(dt);
    if (p.weaponCd > 0) p.weaponCd -= dt * 60;
    if (p.abilityECd > 0) p.abilityECd -= dt * 60;
    if (p.abilityCCd > 0) p.abilityCCd -= dt * 60;
    if (p.invuln > 0) p.invuln -= dt * 60;
    if (p.comboTimer > 0) { p.comboTimer -= dt * 60; if (p.comboTimer <= 0) p.combo = 0; }
    if (p.ultActive) { p.ultTimer -= dt * 60; if (p.ultTimer <= 0) p.ultActive = false; }
    if (p.regen) p.hp = Math.min(p.maxHp, p.hp + p.regen * dt);
    if (p.reactionTimer > 0) p.reactionTimer -= dt * 60;
    if (screenFlash.alpha > 0) screenFlash.alpha -= dt * 3;
    for (let i = floatingTexts.length - 1; i >= 0; i--) {
        const ft = floatingTexts[i];
        ft.y += ft.vy * dt; ft.vy *= 0.97; ft.life--;
        if (ft.life <= 0) floatingTexts.splice(i, 1);
    }
    for (const c of game.companions) c.update(dt, p, game.enemies);
    for (const npc of game.npcs) npc.update(dt, p);
    let mx = 0, my = 0;
    if (keys['KeyW'] || keys['ArrowUp']) my -= 1;
    if (keys['KeyS'] || keys['ArrowDown']) my += 1;
    if (keys['KeyA'] || keys['ArrowLeft']) mx -= 1;
    if (keys['KeyD'] || keys['ArrowRight']) mx += 1;
    if (mx || my) {
        const len = Math.hypot(mx, my); mx /= len; my /= len;
        p.x += mx * p.speed * dt; p.y += my * p.speed * dt;
        if (!game.enemies.some(e => e.hp > 0)) { p.facing.x = mx; p.facing.y = my; }
    }
    p.x = Math.max(p.w/2, Math.min(W - p.w/2, p.x));
    p.y = Math.max(p.h/2, Math.min(H - p.h/2, p.y));
    if (game.shake > 0) {
        game.shakeX = (Math.random() - 0.5) * game.shake;
        game.shakeY = (Math.random() - 0.5) * game.shake;
        game.shake *= 0.88;
        if (game.shake < 0.3) game.shake = 0;
    }
    for (let i = game.projectiles.length - 1; i >= 0; i--) {
        const pr = game.projectiles[i];
        if (!pr.trail) pr.trail = [];
        pr.trail.push({ x: pr.x, y: pr.y, life: 15 });
        for (let t = pr.trail.length - 1; t >= 0; t--) { pr.trail[t].life--; if (pr.trail[t].life <= 0) pr.trail.splice(t, 1); }
        pr.x += pr.vx * dt; pr.y += pr.vy * dt;
        pr.traveled += Math.hypot(pr.vx, pr.vy) * dt;
        let hit = false;
        if (pr.hostile) { if (Math.abs(pr.x - p.x) < p.w/2 && Math.abs(pr.y - p.y) < p.h/2) { damagePlayer(pr.dmg); hit = true; } }
        else {
            for (const e of game.enemies) {
                if (e.hp <= 0) continue;
                if (Math.abs(pr.x - e.x) < e.size/2 + pr.radius && Math.abs(pr.y - e.y) < e.size/2 + pr.radius) {
                    damageEnemy(e, pr.dmg, pr.color);
                    if (pr.aoe) { for (const e2 of game.enemies) if (e2 !== e && e2.hp>0 && Math.hypot(e2.x-e.x, e2.y-e.y)<80) damageEnemy(e2, Math.floor(pr.dmg*0.6), pr.color); }
                    hit = true; break;
                }
            }
        }
        if (hit || pr.traveled > pr.range || pr.x < -50 || pr.x > W+50 || pr.y < -50 || pr.y > H+50) {
            for (let k = 0; k < 4; k++) { const a = Math.random()*Math.PI*2; addParticle(pr.x, pr.y, pr.color, Math.cos(a)*150, Math.sin(a)*150, 20); }
            game.projectiles.splice(i, 1);
        }
    }
    for (const e of game.enemies) {
        if (e.hp <= 0) continue;
        if (e.spawnTime > 0) e.spawnTime -= dt * 60;
        if (e.hitFlash > 0) e.hitFlash--;
        if (e.stunned > 0) { e.stunned -= dt * 60; continue; }
        if (e.attackCd > 0) e.attackCd -= dt * 60;
        if (e.projCd > 0) e.projCd -= dt * 60;
        if (e.dialogueTimer > 0) e.dialogueTimer -= dt * 60;
        const dx = p.x - e.x, dy = p.y - e.y;
        const dist = Math.hypot(dx, dy);
        const hpPct = e.hp / e.maxHp;
        if (e.isBoss) {
            if (hpPct < 0.3 && e.bossPhase < 3) { e.bossPhase = 3; e.speed *= 1.5; e.dmg = Math.round(e.dmg * 1.5); addMessage('💀 ' + e.type.name + ' ENFURECEU!', '#ff4444', 2.5); triggerShake(20); e.dialogue = 'IMPOSSSÍVEL!'; e.dialogueTimer = 150; screenFlash.alpha = 0.4; screenFlash.r = 255; screenFlash.g = 0; screenFlash.b = 0; }
            else if (hpPct < 0.6 && e.bossPhase < 2) { e.bossPhase = 2; e.speed *= 1.25; addMessage('⚠️ ' + e.type.name + ' furioso!', '#ffcc44', 2); }
        }
        if (e.isRanged) {
            const prefDist = e.type.prefDist || 250;
            if (dist > prefDist + 50) { e.x += (dx/dist) * e.speed * dt; e.y += (dy/dist) * e.speed * dt; }
            else if (dist < prefDist - 50) { e.x -= (dx/dist) * e.speed * dt * 0.7; e.y -= (dy/dist) * e.speed * dt * 0.7; }
            if (e.projCd <= 0 && dist < 600) { e.projCd = e.type.projCd || 90; game.projectiles.push({ x: e.x, y: e.y, vx: (dx/dist) * (e.type.projSpeed||300), vy: (dy/dist) * (e.type.projSpeed||300), dmg: e.type.projDmg||12, color: '#cc66ff', range: 700, traveled: 0, radius: 7, hostile: true, trail: [] }); }
        } else {
            if (dist > 15) { e.x += (dx/dist) * e.speed * dt; e.y += (dy/dist) * e.speed * dt; }
            if (dist < 35 + p.w/2 && e.attackCd <= 0) { damagePlayer(e.dmg); e.attackCd = 70; }
        }
        if (e.isBoss) {
            e.bossCd -= dt * 60;
            if (e.bossCd <= 0) {
                e.bossCd = Math.max(120, 300 - e.bossPhase * 60);
                if (e.typeKey === 'arvoreAncestral') { for (let i = 0; i < e.bossPhase * 2; i++) { const a = Math.random()*Math.PI*2; spawnEnemyAt('arvore', e.x + Math.cos(a)*100, e.y + Math.sin(a)*100); } e.dialogue = 'A floresta obedece!'; e.dialogueTimer = 120; }
                else if (e.typeKey === 'lobisomemAncestral') { triggerShake(15 * e.bossPhase); if (e.bossPhase >= 2) damagePlayer(Math.floor(e.dmg * 0.4)); e.dialogue = 'AAAUUUU!'; e.dialogueTimer = 100; }
                else if (e.typeKey === 'senhorSombrio') { e.x = 100 + Math.random() * (W - 200); e.y = 100 + Math.random() * (H - 200); for (let i = 0; i < e.bossPhase; i++) { const a = Math.random()*Math.PI*2; spawnEnemyAt('sombria', e.x + Math.cos(a)*80, e.y + Math.sin(a)*80); } e.dialogue = 'Vocês não me alcançam!'; e.dialogueTimer = 100; }
            }
        }
    }
    for (let i = game.powerups.length - 1; i >= 0; i--) {
        const pu = game.powerups[i];
        pu.life--;
        if (pu.life <= 0) { game.powerups.splice(i, 1); continue; }
        if (Math.hypot(pu.x - p.x, pu.y - p.y) < 40) { collectPowerup(pu); game.powerups.splice(i, 1); }
    }
    for (let i = game.particles.length - 1; i >= 0; i--) {
        const pt = game.particles[i];
        pt.x += pt.vx * dt; pt.y += pt.vy * dt;
        pt.vy += pt.gravity * dt;
        pt.vx *= 0.96; pt.vy *= 0.96;
        pt.life--;
        if (pt.life <= 0) game.particles.splice(i, 1);
    }
    for (let i = game.damageNumbers.length - 1; i >= 0; i--) {
        const dn = game.damageNumbers[i];
        dn.y += dn.vy * dt; dn.vy *= 0.97; dn.life--;
        if (dn.life <= 0) game.damageNumbers.splice(i, 1);
    }
    for (let i = game.messages.length - 1; i >= 0; i--) { game.messages[i].life--; if (game.messages[i].life <= 0) game.messages.splice(i, 1); }
    const alive = game.enemies.filter(e => e.hp > 0).length;
    if (alive === 0 && game.waveActive) {
        game.waveActive = false;
        if (game.wave >= WAVES.length - 1) {
            if (!game.storyTriggers.has('final_moral')) {
                game.storyTriggers.add('final_moral');
                setTimeout(() => { if (state === 'playing' || state === 'story') showStoryChoice('final_moral', () => endGame(true, p.karma)); }, 300);
            } else endGame(true, p.karma);
        } else { game.waveTransition = 180; addMessage('✅ Onda concluída!', '#88ff88', 2); }
    }
    if (game.waveTransition > 0) { game.waveTransition -= dt * 60; if (game.waveTransition <= 0) startWave(game.wave + 1); }
    updateHUD();
}

// ==================== DRAW ====================
function draw() {
    ctx.clearRect(0, 0, W, H);
    if (!game || !game.player || !environment) return;
    const biome = BIOMES[game.biome] || BIOMES.forest;
    const t = game.time;
    const skyInfo = environment.getSkyInfo();
    ctx.save();
    ctx.translate(game.shakeX, game.shakeY);
    const skyGrad = ctx.createLinearGradient(0, 0, 0, H);
    skyGrad.addColorStop(0, skyInfo.skyColor1);
    skyGrad.addColorStop(1, biome.bg2);
    ctx.fillStyle = skyGrad;
    ctx.fillRect(-30, -30, W+60, H+60);
    for (const c of environment.clouds) {
        ctx.fillStyle = `rgba(240,245,255,${0.4 + environment.timeOfDay * 0.15})`;
        ctx.beginPath();
        ctx.arc(c.x, c.y, 30 * c.scale, 0, Math.PI * 2);
        ctx.arc(c.x + 25 * c.scale, c.y + 10 * c.scale, 25 * c.scale, 0, Math.PI * 2);
        ctx.arc(c.x - 20 * c.scale, c.y + 5 * c.scale, 22 * c.scale, 0, Math.PI * 2);
        ctx.fill();
    }
    const windSway = Math.sin(t * 2 + performance.now() * 0.001) * environment.windStrength * 5;
    for (let i = 0; i < 25; i++) {
        const x = ((i * 137 + t * 3) % (W + 100)) - 50;
        const y = (i * 89) % H;
        const scale = 0.5 + (i % 3) * 0.2;
        ctx.fillStyle = `rgba(60,110,60,${0.45 + environment.timeOfDay * 0.3})`;
        ctx.beginPath();
        ctx.moveTo(x + windSway * 0.5, y - 40 * scale);
        ctx.lineTo(x - 20 * scale, y + 10 * scale);
        ctx.lineTo(x + 20 * scale, y + 10 * scale);
        ctx.closePath(); ctx.fill();
    }
    ctx.fillStyle = biome.fog;
    for (let i = 0; i < 5; i++) {
        const fx = (t * 20 + i * 200) % (W + 200) - 100;
        const fy = 100 + Math.sin(t + i) * 100;
        ctx.beginPath(); ctx.arc(fx, fy, 130, 0, Math.PI * 2); ctx.fill();
    }
    environment.drawParticles(ctx);
    for (const npc of game.npcs) npc.draw(ctx);
    for (const pu of game.powerups) {
        const bob = Math.sin(t * 4 + pu.animOffset) * 5;
        ctx.save();
        ctx.shadowColor = pu.color; ctx.shadowBlur = 25;
        ctx.fillStyle = pu.color;
        ctx.beginPath(); ctx.arc(pu.x, pu.y + bob, 22, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#fff'; ctx.font = '22px "Courier New"'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(pu.icon, pu.x, pu.y + bob);
        ctx.restore();
    }
    for (const pr of game.projectiles) {
        if (pr.trail) {
            for (const tr of pr.trail) {
                ctx.globalAlpha = tr.life / 15 * 0.7;
                ctx.fillStyle = pr.color;
                ctx.beginPath(); ctx.arc(tr.x, tr.y, pr.radius * 0.9, 0, Math.PI * 2); ctx.fill();
            }
            ctx.globalAlpha = 1;
        }
    }
    for (const pt of game.particles) {
        ctx.globalAlpha = Math.min(1, pt.life / pt.maxLife);
        if (pt.shape === 'ring') { ctx.strokeStyle = pt.color; ctx.lineWidth = 4; ctx.beginPath(); const progress = 1 - pt.life / pt.maxLife; ctx.arc(pt.x, pt.y, progress * pt.size, 0, Math.PI * 2); ctx.stroke(); }
        else if (pt.shape === 'arc') { ctx.strokeStyle = pt.color; ctx.lineWidth = 4; ctx.beginPath(); ctx.arc(pt.x, pt.y, pt.size * (1 - pt.life / pt.maxLife), 0, Math.PI * 2); ctx.stroke(); }
        else { ctx.fillStyle = pt.color; ctx.beginPath(); ctx.arc(pt.x, pt.y, pt.size, 0, Math.PI * 2); ctx.fill(); }
    }
    ctx.globalAlpha = 1;
    for (const e of game.enemies) { if (e.hp > 0) drawEnemy(e, t); }
    for (const pr of game.projectiles) {
        ctx.save();
        ctx.shadowColor = pr.color; ctx.shadowBlur = 20;
        ctx.fillStyle = pr.color;
        ctx.beginPath(); ctx.arc(pr.x, pr.y, pr.radius + 2, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
    }
    for (const c of game.companions) c.draw(ctx);
    drawPlayer(t);
    for (const ft of floatingTexts) {
        const alpha = Math.min(1, ft.life / 40);
        ctx.globalAlpha = alpha;
        ctx.font = 'bold 14px "Courier New"'; ctx.textAlign = 'center';
        ctx.strokeStyle = '#000'; ctx.lineWidth = 4;
        ctx.strokeText(ft.text, ft.x, ft.y);
        ctx.fillStyle = ft.color;
        ctx.fillText(ft.text, ft.x, ft.y);
    }
    ctx.globalAlpha = 1;
    for (const dn of game.damageNumbers) {
        const alpha = dn.life / dn.maxLife;
        const scale = dn.big ? (1 + (1 - alpha) * 0.3) : 1;
        ctx.globalAlpha = alpha;
        ctx.font = `bold ${Math.floor(19 * scale)}px "Courier New"`;
        ctx.fillStyle = dn.color;
        ctx.textAlign = 'center';
        ctx.strokeStyle = '#000'; ctx.lineWidth = 4;
        if (dn.big) ctx.shadowColor = dn.color, ctx.shadowBlur = 15;
        ctx.strokeText(dn.text, dn.x, dn.y);
        ctx.fillText(dn.text, dn.x, dn.y);
    }
    ctx.globalAlpha = 1; ctx.shadowBlur = 0;
    environment.drawWeatherOverlay(ctx);
    if (screenFlash.alpha > 0) {
        ctx.fillStyle = `rgba(${screenFlash.r},${screenFlash.g},${screenFlash.b},${screenFlash.alpha})`;
        ctx.fillRect(0, 0, W, H);
    }
    ctx.restore();
    drawUI();
}

function drawPlayer(t) {
    const p = game.player;
    const flash = p.invuln > 0 && Math.floor(t * 20) % 2 === 0;
    ctx.save();
    if (p.ultActive) {
        const auraColor = p.char.abilityX.color;
        ctx.globalAlpha = 0.4 + Math.sin(t*10)*0.15;
        ctx.fillStyle = auraColor;
        ctx.beginPath(); ctx.arc(p.x, p.y, 65 + p.evoLevel*10, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
    }
    const shieldPct = p.shield / p.maxShield;
    if (p.shield > 0) {
        const pulse = p.shieldActive ? (0.7 + Math.sin(t*10)*0.3) : 0.45;
        const radius = 44 + Math.sin(t * 3) * 2;
        ctx.strokeStyle = p.shieldActive ? '#ccedff' : '#88ddff';
        ctx.lineWidth = p.shieldActive ? 4 : 3;
        ctx.globalAlpha = pulse * shieldPct;
        ctx.beginPath(); ctx.arc(p.x, p.y, radius, 0, Math.PI * 2); ctx.stroke();
        ctx.fillStyle = 'rgba(150,220,255,' + (pulse * 0.2 * shieldPct) + ')';
        ctx.beginPath(); ctx.arc(p.x, p.y, radius, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
    }
    ctx.shadowColor = p.char.color; ctx.shadowBlur = 25;
    ctx.fillStyle = flash ? '#fff' : p.char.color;
    ctx.beginPath(); ctx.ellipse(p.x, p.y, p.w/2, p.h/2, 0, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = '#fff'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.ellipse(p.x, p.y, p.w/2, p.h/2, 0, 0, Math.PI * 2); ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.fillStyle = '#ffe0c0';
    ctx.beginPath(); ctx.arc(p.x, p.y - 15, 14, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = p.char.hairColor;
    ctx.beginPath(); ctx.arc(p.x, p.y - 20, 14, Math.PI, 0); ctx.fill();
    ctx.fillStyle = '#000';
    const eyeOff = p.facing.x * 3;
    ctx.beginPath();
    ctx.arc(p.x - 4 + eyeOff, p.y - 15, 3, 0, Math.PI * 2);
    ctx.arc(p.x + 4 + eyeOff, p.y - 15, 3, 0, Math.PI * 2);
    ctx.fill();
    const w = getCurrentWeapon();
    ctx.save();
    ctx.translate(p.x + p.facing.x * 24, p.y + p.facing.y * 24);
    ctx.rotate(Math.atan2(p.facing.y, p.facing.x));
    ctx.shadowColor = w.color; ctx.shadowBlur = 18;
    ctx.font = '24px "Courier New"'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(w.icon, 0, 0);
    ctx.restore();
    ctx.font = 'bold 12px "Courier New"'; ctx.textAlign = 'center';
    ctx.strokeStyle = '#000'; ctx.lineWidth = 4;
    ctx.strokeText(p.char.name, p.x, p.y - 42);
    ctx.fillStyle = '#fff';
    ctx.fillText(p.char.name, p.x, p.y - 42);
    if (p.reactionTimer > 0 && p.reactionText) {
        const alpha = Math.min(1, p.reactionTimer / 30);
        ctx.globalAlpha = alpha;
        const text = p.reactionText;
        ctx.font = 'bold 12px "Courier New"';
        const tw = ctx.measureText(text).width + 20;
        const bx = p.x - tw/2, by = p.y - 80;
        ctx.fillStyle = 'rgba(30,50,30,0.95)';
        ctx.beginPath(); ctx.roundRect(bx, by, tw, 24, 6); ctx.fill();
        ctx.strokeStyle = p.char.color; ctx.lineWidth = 2; ctx.stroke();
        ctx.fillStyle = 'rgba(30,50,30,0.95)';
        ctx.beginPath(); ctx.moveTo(p.x - 5, by + 24); ctx.lineTo(p.x, by + 30); ctx.lineTo(p.x + 5, by + 24); ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.fillText(text, p.x, by + 16);
        ctx.globalAlpha = 1;
    }
    ctx.restore();
}

function drawEnemy(e, t) {
    const flash = e.hitFlash > 0;
    const bob = Math.sin(t * 5 + e.animOffset) * 3;
    const sz = e.size;
    ctx.save();
    if (e.spawnTime > 0) {
        const pct = 1 - e.spawnTime / 30;
        ctx.globalAlpha = pct;
        ctx.strokeStyle = '#ff6666'; ctx.lineWidth = 4;
        ctx.beginPath(); ctx.arc(e.x, e.y, sz * 0.5 * (1 - pct) + sz, 0, Math.PI * 2); ctx.stroke();
    }
    ctx.shadowColor = e.type.color; ctx.shadowBlur = flash ? 30 : 18;
    const baseColor = flash ? '#fff' : e.type.color;
    ctx.fillStyle = baseColor;
    if (e.isBoss) {
        ctx.globalAlpha = 0.4;
        const pulse = 1 + Math.sin(t*3) * 0.1;
        ctx.beginPath(); ctx.arc(e.x, e.y + bob, sz * 0.75 * pulse, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1;
        if (e.bossPhase === 2) { ctx.strokeStyle = '#ffcc22'; ctx.lineWidth = 4; ctx.beginPath(); ctx.arc(e.x, e.y+bob, sz*0.7, 0, Math.PI*2); ctx.stroke(); }
        if (e.bossPhase === 3) { ctx.strokeStyle = '#ff4444'; ctx.lineWidth = 5; ctx.beginPath(); ctx.arc(e.x, e.y+bob, sz*0.75 + Math.sin(t*8)*6, 0, Math.PI*2); ctx.stroke(); }
        ctx.font = `${sz}px "Courier New"`;
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(e.type.icon, e.x, e.y + bob);
    } else {
        ctx.font = `${sz * 0.85}px "Courier New"`;
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(e.type.icon, e.x, e.y + bob);
    }
    const barW = e.isBoss ? 160 : 65;
    const barH = e.isBoss ? 12 : 7;
    const barX = e.x - barW/2;
    const barY = e.y - sz/2 - (e.isBoss ? 40 : 20);
    ctx.shadowBlur = 0;
    ctx.fillStyle = '#1a1a1a'; ctx.fillRect(barX, barY, barW, barH);
    const hpPct = Math.max(0, e.hp / e.maxHp);
    ctx.fillStyle = hpPct > 0.5 ? '#66ff66' : (hpPct > 0.25 ? '#ffcc22' : '#ff5555');
    ctx.fillRect(barX, barY, barW * hpPct, barH);
    ctx.strokeStyle = '#000'; ctx.lineWidth = 2; ctx.strokeRect(barX, barY, barW, barH);
    let nameText = e.type.icon + ' ' + e.type.name;
    if (e.isBoss) nameText += ' [F' + e.bossPhase + ']';
    ctx.font = e.isBoss ? 'bold 14px "Courier New"' : 'bold 12px "Courier New"';
    ctx.textAlign = 'center';
    ctx.strokeStyle = '#000'; ctx.lineWidth = 4;
    ctx.strokeText(nameText, e.x, barY - 7);
    ctx.fillStyle = e.isBoss ? '#ff9999' : '#ffffff';
    ctx.fillText(nameText, e.x, barY - 7);
    if (e.dialogueTimer > 0 && e.dialogue) {
        const alpha = Math.min(1, e.dialogueTimer / 30);
        ctx.globalAlpha = alpha;
        const text = e.dialogue;
        ctx.font = 'bold 13px "Courier New"';
        const tw = ctx.measureText(text).width + 24;
        const bx = e.x - tw/2, by = e.y - sz/2 - 80;
        ctx.fillStyle = 'rgba(80,20,20,0.95)';
        ctx.beginPath(); ctx.roundRect(bx, by, tw, 26, 6); ctx.fill();
        ctx.strokeStyle = '#ff6666'; ctx.lineWidth = 2; ctx.stroke();
        ctx.fillStyle = 'rgba(80,20,20,0.95)';
        ctx.beginPath(); ctx.moveTo(e.x - 6, by + 26); ctx.lineTo(e.x, by + 34); ctx.lineTo(e.x + 6, by + 26); ctx.fill();
        ctx.fillStyle = '#ffaaaa';
        ctx.fillText(text, e.x, by + 17);
        ctx.globalAlpha = 1;
    }
    ctx.restore();
}

function drawUI() {
    if (game.boss && game.boss.hp > 0) {
        const barW = W * 0.6, barH = 26, barX = (W - barW) / 2, barY = 80;
        ctx.fillStyle = 'rgba(30,10,10,0.9)'; ctx.fillRect(barX-10, barY-10, barW+20, barH+20);
        ctx.strokeStyle = '#ff6666'; ctx.lineWidth = 3; ctx.strokeRect(barX-10, barY-10, barW+20, barH+20);
        ctx.fillStyle = '#1a1a1a'; ctx.fillRect(barX, barY, barW, barH);
        const pct = game.boss.hp / game.boss.maxHp;
        const grad = ctx.createLinearGradient(barX, 0, barX + barW, 0);
        grad.addColorStop(0, '#ff3333'); grad.addColorStop(1, '#ff8866');
        ctx.fillStyle = grad; ctx.fillRect(barX, barY, barW * pct, barH);
        ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(barX + barW * 0.6, barY); ctx.lineTo(barX + barW * 0.6, barY + barH); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(barX + barW * 0.3, barY); ctx.lineTo(barX + barW * 0.3, barY + barH); ctx.stroke();
        ctx.font = 'bold 16px "Courier New"'; ctx.textAlign = 'center';
        ctx.strokeStyle = '#000'; ctx.lineWidth = 4;
        ctx.strokeText('👑 ' + game.boss.type.name + ' [FASE ' + game.boss.bossPhase + '] — ' + Math.ceil(game.boss.hp) + ' / ' + game.boss.maxHp, W/2, barY + 18);
        ctx.fillStyle = '#ffffff';
        ctx.fillText('👑 ' + game.boss.type.name + ' [FASE ' + game.boss.bossPhase + '] — ' + Math.ceil(game.boss.hp) + ' / ' + game.boss.maxHp, W/2, barY + 18);
    }
    if (game.messages.length > 0) {
        const msg = game.messages[game.messages.length - 1];
        const alpha = Math.min(1, msg.life / 40);
        ctx.globalAlpha = alpha;
        ctx.font = 'bold 24px "Courier New"'; ctx.textAlign = 'center';
        const textW = ctx.measureText(msg.text).width + 70;
        ctx.fillStyle = 'rgba(30,40,30,0.9)'; ctx.fillRect(W/2 - textW/2, 120, textW, 48);
        ctx.strokeStyle = msg.color; ctx.lineWidth = 3; ctx.strokeRect(W/2 - textW/2, 120, textW, 48);
        ctx.strokeStyle = '#000'; ctx.lineWidth = 5;
        ctx.strokeText(msg.text, W/2, 152);
        ctx.fillStyle = msg.color;
        ctx.fillText(msg.text, W/2, 152);
        ctx.globalAlpha = 1; ctx.shadowBlur = 0;
    }
    if (game.player.combo > 2) {
        const comboT = Math.min(1, game.player.comboTimer / 30);
        ctx.globalAlpha = comboT;
        ctx.font = 'bold 38px "Courier New"'; ctx.textAlign = 'right';
        ctx.strokeStyle = '#000'; ctx.lineWidth = 6;
        ctx.strokeText('x' + game.player.combo + ' COMBO!', W - 30, H - 130);
        ctx.fillStyle = '#ffee44'; ctx.shadowColor = '#ffaa00'; ctx.shadowBlur = 25;
        ctx.fillText('x' + game.player.combo + ' COMBO!', W - 30, H - 130);
        ctx.globalAlpha = 1; ctx.shadowBlur = 0;
    }
    if (game.player) {
        for (const npc of game.npcs) {
            const dist = Math.hypot(npc.x - game.player.x, npc.y - game.player.y);
            if (dist < 80) {
                ctx.fillStyle = 'rgba(30,50,30,0.95)';
                ctx.font = 'bold 13px "Courier New"';
                const text = 'Pressione T para falar';
                const tw = ctx.measureText(text).width + 24;
                const bx = npc.x - tw/2, by = npc.y - 70;
                ctx.beginPath(); ctx.roundRect(bx, by, tw, 24, 5); ctx.fill();
                ctx.strokeStyle = '#88ff88'; ctx.lineWidth = 2; ctx.stroke();
                ctx.fillStyle = '#88ff88'; ctx.textAlign = 'center';
                ctx.fillText(text, npc.x, by + 16);
            }
        }
    }
}

function updateHUD() {
    const p = game.player;
    document.getElementById('hpFill').style.width = (Math.max(0, p.hp / p.maxHp) * 100) + '%';
    document.getElementById('hpText').textContent = Math.max(0, Math.ceil(p.hp)) + ' / ' + p.maxHp;
    document.getElementById('shieldFill').style.width = (p.shield / p.maxShield * 100) + '%';
    document.getElementById('shieldText').textContent = '🛡️ ' + Math.ceil(p.shield) + ' / ' + p.maxShield;
    document.getElementById('xpFill').style.width = Math.min(100, (game.xp / game.xpToNext) * 100) + '%';
    document.getElementById('levelDisplay').textContent = game.level;
    document.getElementById('xpDisplay').textContent = game.xp + ' / ' + game.xpToNext;
    document.getElementById('evoBadge').textContent = p.evoLevel > 0 ? ' ★' + p.evoLevel : '';
    document.getElementById('goldDisplay').textContent = p.gold;
    const lowHpVig = document.getElementById('lowHpVignette');
    if (p.hp < p.maxHp * 0.3 && p.hp > 0) lowHpVig.style.opacity = '1'; else lowHpVig.style.opacity = '0';
    const weatherInfo = { clear:{icon:'☀️',text:'Limpo'}, rain:{icon:'🌧️',text:'Chuva'}, fog:{icon:'🌫️',text:'Névoa'}, storm:{icon:'⛈️',text:'Tempestade'} };
    const w = weatherInfo[environment.weather];
    document.getElementById('weatherIcon').textContent = w.icon;
    document.getElementById('weatherText').textContent = w.text;
    const tod = environment.timeOfDay;
    let timeStr = 'Noite';
    if (tod < 0.2) timeStr = 'Madrugada';
    else if (tod < 0.35) timeStr = 'Amanhecer';
    else if (tod < 0.65) timeStr = 'Dia';
    else if (tod < 0.8) timeStr = 'Entardecer';
    document.getElementById('timeText').textContent = timeStr;
    const wave = WAVES[game.wave];
    document.getElementById('waveNumDisplay').textContent = game.wave + 1;
    document.getElementById('waveNameDisplay').textContent = wave ? wave.name : '';
    document.getElementById('waveCountDisplay').textContent = 'Inimigos: ' + game.waveDefeated + '/' + game.waveTotal;
    const wpn = getCurrentWeapon();
    document.getElementById('wpnIcon').textContent = wpn.icon;
    document.getElementById('wpnName').textContent = wpn.name;
    document.getElementById('wpnCat').textContent = wpn.cat;
    const nextW = WEAPONS[(p.currentWeapon + 1) % WEAPONS.length];
    document.getElementById('wpnNext').textContent = 'Próxima (Q): ' + nextW.name;
    const abE = p.char.abilityE;
    const abEcd = Math.ceil(p.abilityECd / 60);
    document.getElementById('abEName').textContent = abE.name;
    document.getElementById('abEStatus').textContent = abEcd > 0 ? abEcd + 's' : '✓';
    document.getElementById('abEStatus').className = 'ab-status' + (abEcd > 0 ? ' cd' : '');
    if (abEcd > 0) document.getElementById('abE').classList.remove('ready'); else document.getElementById('abE').classList.add('ready');
    document.getElementById('abXName').textContent = p.char.abilityX.name;
    const abXEl = document.getElementById('abX');
    if (p.ultActive) { document.getElementById('abXStatus').textContent = 'ATIVO'; abXEl.classList.add('active'); abXEl.classList.remove('full'); }
    else if (p.ultCharge >= 100) { document.getElementById('abXStatus').textContent = 'PRONTO!'; abXEl.classList.add('full'); abXEl.classList.remove('active'); }
    else { document.getElementById('abXStatus').textContent = Math.floor(p.ultCharge) + '%'; abXEl.classList.remove('full', 'active'); }
    document.getElementById('abCName').textContent = p.char.abilityC.name;
    if (p.superCharge >= 100) { document.getElementById('abCStatus').textContent = 'PRONTO!'; document.getElementById('abC').classList.add('full'); }
    else { document.getElementById('abCStatus').textContent = Math.floor(p.superCharge) + '%'; document.getElementById('abC').classList.remove('full'); }
    const abSEl = document.getElementById('abS');
    const sStatus = document.getElementById('abSStatus');
    if (p.shieldActive) { sStatus.textContent = Math.ceil(p.shieldActiveTimer/60) + 's'; abSEl.classList.remove('ready'); }
    else if (p.shieldActiveCd > 0) { sStatus.textContent = Math.ceil(p.shieldActiveCd/60) + 's'; abSEl.classList.remove('ready'); }
    else if (p.shield > 0) { sStatus.textContent = '✓'; abSEl.classList.add('ready'); }
    else { sStatus.textContent = '0%'; abSEl.classList.remove('ready'); }
    document.getElementById('charNameDisplay').textContent = p.char.name;
    document.getElementById('charBonusDisplay').textContent = p.char.bonus;
    document.getElementById('charEvoDisplay').textContent = p.evoLevel > 0 ? 'Evolução ' + p.evoLevel + '/3' : 'Nível 1';
    const comboEl = document.getElementById('comboBox');
    if (p.combo > 2) { comboEl.classList.add('show'); document.getElementById('comboCount').textContent = 'x' + p.combo; }
    else comboEl.classList.remove('show');
    updateKarmaDisplay();
}

function endGame(victory, karma) {
    state = 'end';
    game.paused = true;
    const title = document.getElementById('endTitle');
    const subtitle = document.getElementById('endSubtitle');
    const stats = document.getElementById('endStats');
    const karmaInfo = getKarmaLabel(karma || 0);
    if (victory) {
        audio.victory();
        let endingName = 'Conquistadores Gananciosos', endingColor = '#ffee44', endingIcon = '💰';
        if (karma >= 8) { endingName = 'SANTO REDIMIDO'; endingColor = '#ffffff'; endingIcon = '😇'; }
        else if (karma >= 4) { endingName = 'HERÓIS DA FLORESTA'; endingColor = '#ffdd22'; endingIcon = '🏆'; }
        else if (karma >= 0) { endingName = 'AVENTUREIROS'; endingColor = '#88ff88'; endingIcon = '🎖️'; }
        else if (karma >= -5) { endingName = 'CAÇADORES'; endingColor = '#ffaa66'; endingIcon = '💀'; }
        else { endingName = 'DEMÔNIOS DA MATA'; endingColor = '#ff4444'; endingIcon = '👹'; }
        title.textContent = endingIcon + ' VITÓRIA! ' + endingIcon;
        title.className = 'end-title end-victory';
        title.style.color = endingColor;
        subtitle.textContent = 'Final: ' + endingName;
        subtitle.style.color = endingColor;
        stats.innerHTML = `<div style="color:${karmaInfo.color};font-size:1.3rem;margin-bottom:0.8rem;">${karmaInfo.icon} Karma: <b>${karmaInfo.label}</b> (${karma})</div>
            <div>⭐ Nível: <b>${game.level}</b></div>
            <div>✨ Evolução: <b>${game.player.evoLevel}/3</b></div>
            <div>💀 Inimigos: <b>${game.player.kills}</b></div>
            <div>💰 Ouro Final: <b>${game.player.gold}</b></div>
            <div>🏹 Aliados: <b>${game.companions.length}</b></div>
            <div>📖 Escolhas: <b>${game.storyTriggers.size}</b></div>`;
    } else {
        title.textContent = '💀 GAME OVER 💀';
        title.className = 'end-title end-defeat';
        subtitle.textContent = 'A floresta é implacável...';
        subtitle.style.color = '#ff9999';
        stats.innerHTML = `<div style="color:${karmaInfo.color};margin-bottom:0.8rem;">${karmaInfo.icon} Karma: <b>${karmaInfo.label}</b></div>
            <div>⭐ Nível: <b>${game.level}</b></div>
            <div>💀 Inimigos: <b>${game.player.kills}</b></div>
            <div>💰 Ouro: <b>${game.player.gold}</b></div>
            <div>🌊 Onda: <b>${game.wave + 1}/${WAVES.length}</b></div>`;
    }
    document.getElementById('endOverlay').classList.add('active');
}

// ==================== INPUT ====================
window.addEventListener('keydown', (e) => {
    keys[e.code] = true;
    audio.resume();
    if (['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code)) e.preventDefault();
    if (state === 'playing' && game && !game.paused) {
        if (e.code === 'Space') fireWeapon();
        if (e.code === 'KeyQ') { game.player.currentWeapon = (game.player.currentWeapon + 1) % WEAPONS.length; audio.pickup(); }
        if (e.code === 'KeyF') {
            game.player.charIdx = (game.player.charIdx + 1) % CHARACTERS.length;
            game.player.char = CHARACTERS[game.player.charIdx];
            game.player.weaponCd = 0; game.player.abilityECd = 0; game.player.evoLevel = 0;
            addMessage('👤 ' + game.player.char.name, '#88ddff', 1.5);
        }
        if (e.code === 'KeyE') useAbilityE();
        if (e.code === 'KeyX') useAbilityX();
        if (e.code === 'KeyC') useAbilityC();
        if (e.code === 'KeyS') activateShield();
        if (e.code === 'KeyM') { const m = audio.toggleMute(); addMessage(m ? '🔇 Mudo' : '🔊 Som', '#88ddff', 1.5); }
        if (e.code === 'KeyT') {
            for (const npc of game.npcs) {
                const dist = Math.hypot(npc.x - game.player.x, npc.y - game.player.y);
                if (dist < 80) { audio.dialogue(); openDialogue(npc); break; }
            }
        }
    }
    if (state === 'dialogue' && e.code === 'Escape') closeDialogue();
});
window.addEventListener('keyup', (e) => { keys[e.code] = false; });

setInterval(() => {
    if (state === 'playing' && game && !game.paused && hitStop <= 0) {
        const w = getCurrentWeapon();
        if (w.auto && keys['Space']) fireWeapon();
    }
}, 16);

document.querySelectorAll('.diff-card').forEach(card => {
    card.addEventListener('click', () => {
        document.querySelectorAll('.diff-card').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        difficulty = card.dataset.diff;
    });
});

const charGrid = document.getElementById('charGrid');
CHARACTERS.forEach((c, i) => {
    const div = document.createElement('div');
    div.className = 'char-card' + (i === 0 ? ' selected' : '');
    div.dataset.char = i;
    div.innerHTML = `
        <div class="char-icon">${c.icon}</div>
        <div class="char-name-big">${c.name}</div>
        <div class="char-desc">
            HP: ${c.hp} · Escudo: ${c.shieldBase}<br>
            <b style="color:#aaffaa">E:</b> ${c.abilityE.name}<br>
            <b style="color:#ffaaff">X:</b> ${c.abilityX.name}<br>
            <b style="color:#ffdd44">C:</b> ${c.abilityC.name}
        </div>`;
    div.addEventListener('click', () => {
        document.querySelectorAll('.char-card').forEach(el => el.classList.remove('selected'));
        div.classList.add('selected');
        selectedChar = i;
    });
    charGrid.appendChild(div);
});

document.getElementById('startBtn').addEventListener('click', () => {
    audio.resume();
    document.getElementById('menuOverlay').classList.remove('active');
    initGame(selectedChar);
    state = 'playing';
});

document.getElementById('restartBtn').addEventListener('click', () => {
    document.getElementById('endOverlay').classList.remove('active');
    initGame(selectedChar);
    state = 'playing';
});

document.getElementById('menuBtn').addEventListener('click', () => {
    document.getElementById('endOverlay').classList.remove('active');
    document.getElementById('menuOverlay').classList.add('active');
    state = 'menu';
});

function resizeGame() {
    const scale = Math.min(window.innerWidth / 1240, window.innerHeight / 740, 1);
    document.getElementById('gameContainer').style.transform = `scale(${scale})`;
}
window.addEventListener('resize', resizeGame);
resizeGame();

if (!CanvasRenderingContext2D.prototype.roundRect) {
    CanvasRenderingContext2D.prototype.roundRect = function(x, y, w, h, r) {
        if (w < 2 * r) r = w / 2;
        if (h < 2 * r) r = h / 2;
        this.beginPath();
        this.moveTo(x + r, y);
        this.arcTo(x + w, y, x + w, y + h, r);
        this.arcTo(x + w, y + h, x, y + h, r);
        this.arcTo(x, y + h, x, y, r);
        this.arcTo(x, y, x + w, y, r);
        this.closePath();
        return this;
    };
}

function gameLoop(now) {
    requestAnimationFrame(gameLoop);
    const dt = Math.min((now - lastTime) / 1000, 0.1);
    lastTime = now;
    if (state === 'playing' || state === 'levelup' || state === 'story') {
        update(dt);
        draw();
    }
}
lastTime = performance.now();
requestAnimationFrame(gameLoop);

})();
