class NPC {
    constructor(type, x, y) {
        this.type = type;
        this.x = x; this.y = y;
        this.speed = 40;
        this.phase = Math.random() * Math.PI * 2;
        this.wanderTimer = 0;
        this.wanderDir = { x: 0, y: 0 };
        this.greetingCooldown = 0;
        this.greetingShown = false;
        this.recruited = false;
        this.questGiven = false;
        this.questCompleted = false;
        this.faceDir = 0;
        const configs = {
            hunter: { icon:'🏹', name:'Caçador Silva', sub:'Andarilho da floresta', color:'#ddbb88', greeting: 'Ei! Você aí! Cuidado com as sombras.' },
            merchant: { icon:'🧙', name:'Mercador Zoltar', sub:'Vendedor de bugigangas', color:'#bb99ee', greeting: 'Poções! Armas! Barato só hoje!' },
            spirit: { icon:'👻', name:'Espírito Antigo', sub:'Guardião da floresta', color:'#bbddff', greeting: 'A floresta sussurra seu nome...' },
            wanderer: { icon:'🧎', name:'Andarilho Perdido', sub:'Alma penada', color:'#bbdd99', greeting: 'Vocês... ainda estão vivos?' }
        };
        const t = configs[type] || configs.hunter;
        this.icon = t.icon; this.name = t.name; this.sub = t.sub; this.color = t.color; this.greeting = t.greeting;
    }
    update(dt, player) {
        this.phase += dt * 2;
        this.wanderTimer -= dt * 60;
        if (this.greetingCooldown > 0) this.greetingCooldown -= dt * 60;
        const dist = Math.hypot(player.x - this.x, player.y - this.y);
        if (dist < 150 && !this.greetingShown && this.greetingCooldown <= 0) {
            this.greetingShown = true;
            this.greetingCooldown = 300;
            showFloatingText(this.x, this.y - 60, '"' + this.greeting + '"', this.color);
        }
        if (dist > 250) this.greetingShown = false;
        if (dist < 200) {
            this.faceDir = Math.atan2(player.y - this.y, player.x - this.x);
            this.wanderDir = { x: 0, y: 0 };
        } else {
            if (this.wanderTimer <= 0) {
                this.wanderTimer = 120 + Math.random() * 180;
                const angle = Math.random() * Math.PI * 2;
                this.wanderDir = { x: Math.cos(angle) * 0.5, y: Math.sin(angle) * 0.5 };
            }
            this.x += this.wanderDir.x * this.speed * dt;
            this.y += this.wanderDir.y * this.speed * dt;
            this.x = Math.max(50, Math.min(W - 50, this.x));
            this.y = Math.max(50, Math.min(H - 50, this.y));
        }
    }
    draw(ctx) {
        ctx.fillStyle = 'rgba(0,0,0,0.35)';
        ctx.beginPath(); ctx.ellipse(this.x, this.y + 20, 18, 6, 0, 0, Math.PI * 2); ctx.fill();
        const bob = Math.sin(this.phase) * 3;
        const dist = game ? Math.hypot(game.player.x - this.x, game.player.y - this.y) : 999;
        if (dist < 150) {
            ctx.save();
            ctx.globalAlpha = 0.45 + Math.sin(this.phase * 2) * 0.2;
            const grad = ctx.createRadialGradient(this.x, this.y, 10, this.x, this.y, 60);
            grad.addColorStop(0, this.color + 'aa');
            grad.addColorStop(1, this.color + '00');
            ctx.fillStyle = grad;
            ctx.beginPath(); ctx.arc(this.x, this.y, 60, 0, Math.PI * 2); ctx.fill();
            ctx.restore();
        }
        ctx.save();
        ctx.shadowColor = this.color; ctx.shadowBlur = 18;
        ctx.fillStyle = this.color;
        ctx.beginPath(); ctx.ellipse(this.x, this.y + bob, 16, 22, 0, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
        if (dist < 200) {
            const ex = this.x + Math.cos(this.faceDir) * 8;
            const ey = this.y + bob + Math.sin(this.faceDir) * 8;
            ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(ex, ey, 4, 0, Math.PI * 2); ctx.fill();
            ctx.fillStyle = '#000'; ctx.beginPath(); ctx.arc(ex + Math.cos(this.faceDir) * 1.5, ey + Math.sin(this.faceDir) * 1.5, 2, 0, Math.PI * 2); ctx.fill();
        }
        ctx.font = '22px "Courier New"'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(this.icon, this.x, this.y + bob);
        ctx.strokeStyle = '#000'; ctx.lineWidth = 4;
        ctx.font = 'bold 11px "Courier New"';
        ctx.strokeText(this.name, this.x, this.y - 30 + bob);
        ctx.fillStyle = this.color;
        ctx.fillText(this.name, this.x, this.y - 30 + bob);
        if (this.recruited) {
            ctx.fillStyle = '#88ff88'; ctx.font = 'bold 14px "Courier New"';
            ctx.fillText('✓', this.x + 20, this.y - 30 + bob);
        }
    }
}

