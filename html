    { id:'flamethrower', name:'Lança-Chamas', icon:'🔥', cat:'HEAVY', dmg:2, cd:2, range:200, speed:350, auto:true, spread:0.4, shortRange:true, color:'#ff8844' },
    { id:'plasma', name:'Rifle Plasma', icon:'⚡', cat:'ENERGY', dmg:8, cd:15, range:580, speed:900, auto:true, spread:0.03, color:'#44ffff' },
