        isBoss: false, isRanged: false, bossPhase: 1, projCd: 0, bossCd: 0,
        retreating: false, dialogue: '', dialogueTimer: 0
    });
    game.waveTotal++;
}

function getCurrentWeapon() { return WEAPONS[game.player.currentWeapon]; }
function findNearestEnemy() {
    let nearest = null, nd = Infinity;
    for (const e of game.enemies) { if (e.hp <= 0) continue; const d = (e.x - game.player.x)**2 + (e.y - game.player.y)**2; if (d < nd) { nd = d; nearest = e; } }
    return nearest;
}

function fireWeapon() {
    const p = game.player;
    if (p.weaponCd > 0) return;
    const w = getCurrentWeapon();
    p.weaponCd = w.cd / p.atkSpeedMult;
    audio.shoot(w);
    let dmgMult = p.dmgMult;
    if (w.cat === 'MELEE') {
        const range = w.range * p.rangeMult;
        for (const e of game.enemies) {
            if (e.hp <= 0) continue;
            const d = Math.hypot(e.x - p.x, e.y - p.y);
            if (d < range + e.size/2) {
                damageEnemy(e, Math.round(w.dmg * dmgMult), w.color);
                e.x += ((e.x-p.x)/(d||1)) * 12; e.y += ((e.y-p.y)/(d||1)) * 12;
            }
        }
        addParticle(p.x, p.y, w.color, 0, 0, 20, 'arc', w.range * p.rangeMult);
    } else {
        let dirX = p.facing.x, dirY = p.facing.y;
        const target = findNearestEnemy();
        if (target) {
            const dx = target.x - p.x, dy = target.y - p.y;
            const d = Math.hypot(dx, dy) || 1;
            dirX = dx/d; dirY = dy/d;
            p.facing.x = dirX; p.facing.y = dirY;
        }
        const pellets = w.pellets || 1;
        for (let i = 0; i < pellets; i++) {
            let a = Math.atan2(dirY, dirX);
            if (w.spread) a += (Math.random() - 0.5) * w.spread * 2;
            game.projectiles.push({
                x: p.x + Math.cos(a) * 20, y: p.y + Math.sin(a) * 20,
                vx: Math.cos(a) * w.speed, vy: Math.sin(a) * w.speed,
                dmg: Math.round(w.dmg * dmgMult), color: w.color,
                range: w.range * p.rangeMult, traveled: 0,
                aoe: w.aoe, radius: w.shortRange ? 7 : 5, hostile: false, trail: []
            });
        }
    }
    triggerShake(w.cat === 'SNIPER' ? 8 : w.cat === 'HEAVY' ? 6 : 2);
}

function damageEnemy(e, dmg, color, crit) {
    if (crit) dmg = Math.round(dmg * 2);
    e.hp -= dmg; e.hitFlash = 6;
    audio.hit();
    if (crit || dmg > 20) { screenFlash.alpha = 0.3; screenFlash.r = 255; screenFlash.g = 220; screenFlash.b = 120; }
    hitStop = Math.max(hitStop, crit ? 6 : 2);
    addDamageNumber(e.x, e.y - e.size/2, (crit?'💥':'')+'-' + dmg, crit?'#ff88ff':(color||'#ffee44'), crit);
    addParticle(e.x, e.y, color, 0, 0, 15, 'ring');
    for (let i = 0; i < 6; i++) { const a = Math.random()*Math.PI*2; addParticle(e.x, e.y, color||'#ffee44', Math.cos(a)*180, Math.sin(a)*180, 25); }
    if (e.hp <= 0) onEnemyKilled(e);
}

function onEnemyKilled(e) {
    const bossType = e.typeKey;
    e.hp = 0;
    audio.kill();
    game.waveDefeated++;
    game.player.kills++;
    game.player.combo++;
    game.player.comboTimer = 180;
    const comboEl = document.getElementById('comboCount');
    if (comboEl) { comboEl.classList.remove('bump'); void comboEl.offsetWidth; comboEl.classList.add('bump'); }
    const comboMult = 1 + Math.floor(game.player.combo / 5) * 0.1;
    const xpGain = Math.round(e.xp * game.player.xpMult * comboMult);
    game.xp += xpGain;
    const goldGain = Math.round(e.xp * 0.3);
    game.player.gold += goldGain;
    addDamageNumber(e.x, e.y - e.size/2 - 15, '+' + xpGain + ' XP', '#ffee44');
    if (goldGain > 0) showFloatingText(e.x + 30, e.y - 20, '+' + goldGain + '💰', '#ffcc44');
    if (game.player.char.bonusType === 'heal') game.player.hp = Math.min(game.player.maxHp, game.player.hp + 3);
    game.player.ultCharge = Math.min(100, game.player.ultCharge + (e.isBoss ? 40 : 5));
    game.player.superCharge = Math.min(100, game.player.superCharge + (e.isBoss ? 30 : 3));
    if (Math.random() < 0.15 && game.player.char.reactions) characterReaction(game.player.char.reactions.kill);
    if (Math.random() < 0.15) dropPowerup(e.x, e.y);
    const deathColors = [e.type.color, '#ffffff', '#ffee44'];
    for (let i = 0; i < 20; i++) { const a = Math.random()*Math.PI*2; const spd = 200 + Math.random()*200; const color = deathColors[Math.floor(Math.random()*deathColors.length)]; addParticle(e.x, e.y, color, Math.cos(a)*spd, Math.sin(a)*spd, 50); }
    addParticle(e.x, e.y, '#ffffff', 0, 0, 20, 'ring', 30);
    if (e.isBoss) {
        audio.bossAlert(); triggerShake(25);
        screenFlash.alpha = 0.6; screenFlash.r = 255; screenFlash.g = 240; screenFlash.b = 120;
        hitStop = 15; game.player.gold += 200;
        for (let i = 0; i < 80; i++) { const a = Math.random()*Math.PI*2; const spd = 200+Math.random()*400; addParticle(e.x, e.y, '#ffee44', Math.cos(a)*spd, Math.sin(a)*spd, 80); }
        addMessage('💀 ' + e.type.name + ' DERROTADO! +200💰', '#ffee44', 2.5);
        if (bossType === 'arvoreAncestral' && !game.storyTriggers.has('chest')) {
            game.storyTriggers.add('chest');
            setTimeout(() => { if (state === 'playing') showStoryChoice('chest'); }, 500);
        }
        if (bossType === 'lobisomemAncestral' && !game.storyTriggers.has('ademir')) {
            game.storyTriggers.add('ademir');
            setTimeout(() => { if (state === 'playing') showStoryChoice('ademir'); }, 500);
        }
    }
    checkLevelUp();
}

function damagePlayer(dmg) {
    const p = game.player;
    if (p.invuln > 0) return;
    if (p.ultActive && p.charIdx === 2) return;
    audio.hurt();
    let remainingDmg = dmg;
    if (p.shield > 0) {
        const absorbed = Math.min(p.shield, remainingDmg);
        p.shield -= absorbed; remainingDmg -= absorbed;
        addDamageNumber(p.x, p.y - 50, '🛡️ -' + absorbed, '#88ddff');
        p.shieldPulse = 15;
        for (let i = 0; i < 10; i++) { const a = Math.random()*Math.PI*2; addParticle(p.x, p.y, '#88ddff', Math.cos(a)*200, Math.sin(a)*200, 30); }
        triggerShake(5);
    }
    p.shieldRegenDelay = 180;
    if (remainingDmg > 0) {
        p.hp -= remainingDmg;
        addDamageNumber(p.x, p.y - 35, '-' + remainingDmg, '#ff5555');
        screenFlash.alpha = 0.35; screenFlash.r = 255; screenFlash.g = 0; screenFlash.b = 0;
        hitStop = 4;
        for (let i = 0; i < 12; i++) { const a = Math.random()*Math.PI*2; addParticle(p.x, p.y, '#ff5555', Math.cos(a)*250, Math.sin(a)*250, 30); }
    }
    p.invuln = 30; triggerShake(8);
    if (p.hp < p.maxHp * 0.3 && p.char.reactions && p.reactionTimer <= 0) characterReaction(p.char.reactions.lowHp);
    if (p.hp <= 0) {
        if (p.charIdx === 0 && p.evoLevel >= 3 && !p.reviveUsed) {
            p.reviveUsed = true; p.hp = p.maxHp; p.shield = p.maxShield; p.invuln = 180;
            addMessage('🌟 RESSURREIÇÃO DIVINA!', '#ffee44', 3); triggerShake(15);
        } else { p.hp = 0; audio.death(); endGame(false); }
    }
}

function dropPowerup(x, y) {
    const types = ['health','damage','speed','ult','super','weapon','shield','shield_full','gold'];
    const type = types[Math.floor(Math.random() * types.length)];
    game.powerups.push({
        x, y, type,
        icon: { health:'❤️', damage:'⚔️', speed:'💨', ult:'⭐', super:'🌟', weapon:'🔫', shield:'🛡️', shield_full:'💠', gold:'💰' }[type],
        color: { health:'#ff6666', damage:'#ffaa66', speed:'#88ddff', ult:'#ffee44', super:'#ff88ff', weapon:'#88ff88', shield:'#88ddff', shield_full:'#ccedff', gold:'#ffcc44' }[type],
        life: 600, animOffset: Math.random() * Math.PI * 2
    });
}

function collectPowerup(pu) {
    const p = game.player;
    audio.pickup();
    if (pu.type === 'health') { p.hp = Math.min(p.maxHp, p.hp + 40); addMessage('❤️ +40 HP', '#ff8888', 1.5); }
    else if (pu.type === 'damage') { p.dmgMult += 0.25; addMessage('⚔️ Dano +25%', '#ffaa66', 2); }
    else if (pu.type === 'speed') { p.speed *= 1.15; addMessage('💨 Vel +15%', '#88ddff', 1.5); }
    else if (pu.type === 'ult') { p.ultCharge = Math.min(100, p.ultCharge + 30); addMessage('⭐ Ult +30%', '#ffee44', 1.5); }
    else if (pu.type === 'super') { p.superCharge = Math.min(100, p.superCharge + 25); addMessage('🌟 Super +25%', '#ff88ff', 1.5); }
    else if (pu.type === 'shield') { p.shield = Math.min(p.maxShield, p.shield + 30); addMessage('🛡️ Escudo +30', '#88ddff', 1.5); }
    else if (pu.type === 'shield_full') { p.shield = p.maxShield; p.shieldRegenDelay = 0; addMessage('💠 Escudo cheio!', '#ccedff', 2); }
    else if (pu.type === 'gold') { const g = 10 + Math.floor(Math.random() * 20); p.gold += g; addMessage('💰 +' + g + ' ouro', '#ffcc44', 1.5); }
    else { p.weaponCd = 0; p.abilityECd = 0; p.shieldActiveCd = 0; addMessage('🔫 Cooldowns reset', '#88ff88', 1.5); }
}

function useAbilityE() {
    const p = game.player;
    if (p.abilityECd > 0) return;
    const ab = p.char.abilityE;
    p.abilityECd = ab.cd * 60;
    audio.ability();
    addMessage('✨ ' + ab.name, ab.color, 1.5);
    triggerShake(6);
    for (let i = 0; i < 50; i++) { const a = (i/50)*Math.PI*2; addParticle(p.x, p.y, ab.color, Math.cos(a)*400, Math.sin(a)*400, 40); }
    addParticle(p.x, p.y, ab.color, 0, 0, 25, 'ring', 80);
    if (p.charIdx === 0) { p.hp = Math.min(p.maxHp, p.hp + 40); p.shield = Math.min(p.maxShield, p.shield + 20); for (const e of game.enemies) if (e.hp > 0 && Math.hypot(e.x-p.x, e.y-p.y) < 300) e.stunned = 120; }
    else if (p.charIdx === 1) { for (const e of game.enemies) if (e.hp > 0) { damageEnemy(e, 25, ab.color); e.stunned = 60; } }
    else if (p.charIdx === 2) { for (const e of game.enemies) if (e.hp > 0 && Math.hypot(e.x-p.x, e.y-p.y) < 200) damageEnemy(e, 35, ab.color); }
    else if (p.charIdx === 3) { p.dmgMult += 1.0; setTimeout(() => { if (game) game.player.dmgMult -= 1.0; }, 3000); }
    else if (p.charIdx === 4) {
        for (let i = 0; i < 3; i++) {
            const angle = (i/3) * Math.PI * 2;
            const comp = new Companion('spirit', p.x + Math.cos(angle)*60, p.y + Math.sin(angle)*60, 'Espírito');
            comp.dmg = 10 + p.evoLevel * 5;
            comp.offsetX = Math.cos(angle) * 60; comp.offsetY = Math.sin(angle) * 60;
            game.companions.push(comp);
        }
        addMessage('🌿 Espíritos invocados!', '#66ffaa', 2);
    }
    else if (p.charIdx === 5) { const target = findNearestEnemy(); if (target) { target.marked = true; target.markedTimer = 300; } }
}

function useAbilityX() {
    const p = game.player;
    if (p.ultCharge < 100 || p.ultActive) return;
    p.ultCharge = 0; p.ultActive = true; p.ultTimer = p.char.abilityX.duration * 60;
    audio.ultimate();
    addMessage('💥 ' + p.char.abilityX.name + '!', p.char.abilityX.color, 2.5);
    triggerShake(25);
    screenFlash.alpha = 0.5; screenFlash.r = 255; screenFlash.g = 240; screenFlash.b = 120;
    if (p.charIdx === 0) { p.hp = p.maxHp; p.shield = p.maxShield; p.invuln = 300; }
    else if (p.charIdx === 2) p.invuln = 300;
}

function useAbilityC() {
    const p = game.player;
    if (p.superCharge < 100) return;
    p.superCharge = 0;
    const ab = p.char.abilityC;
    audio.ultimate();
    addMessage('🌟 ' + ab.name + '!', ab.color, 2.5);
    triggerShake(30);
    screenFlash.alpha = 0.7; screenFlash.r = 255; screenFlash.g = 140; screenFlash.b = 220;
    hitStop = 8;
    for (const e of game.enemies) if (e.hp > 0) damageEnemy(e, 80 + p.evoLevel * 10, ab.color);
}

function activateShield() {
    const p = game.player;
    if (p.shieldActive || p.shieldActiveCd > 0 || p.shield <= 0) return;
    p.shieldActive = true; p.shieldActiveTimer = 180; p.shieldActiveCd = 600;
    audio.ability();
    addMessage('🛡️ ESCUDO ATIVO!', '#88ddff', 1.5);
}

function updateShield(dt) {
    const p = game.player;
    if (p.shieldRegenDelay > 0) p.shieldRegenDelay -= dt * 60;
    if (p.shieldPulse > 0) p.shieldPulse -= dt * 60;
    if (p.shieldRegenDelay <= 0 && p.shield < p.maxShield) p.shield = Math.min(p.maxShield, p.shield + p.shieldRegen * dt);
    if (p.shieldActive) { p.shieldActiveTimer -= dt * 60; if (p.shieldActiveTimer <= 0) p.shieldActive = false; }
    if (p.shieldActiveCd > 0) p.shieldActiveCd -= dt * 60;
}

